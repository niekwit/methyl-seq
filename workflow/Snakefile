configfile: "config/config.yaml"


VERSION = "0.6.0"


include: "rules/common.smk"


check_cwd_no_spaces()


containerized: f"docker://niekwit/methyl-seq:{VERSION}"


PAIRED_END = paired_end()
SAMPLES = import_samples(PAIRED_END)
CSV = pd.read_csv("config/samples.csv")
validate(CSV, schema="schemas/samples.schema.yaml")
CONDITIONS = conditions(CSV)
REGIONS = regions()
# META_REGIONS = meta_regions()
validate_reference_condition(config["DMR"]["reference_condition"], CONDITIONS)
TE_REGIONS = te_regions()
validate_te_config(TE_REGIONS, REGIONS, resources)


# Condition and region names can themselves contain underscores (e.g. a
# condition "WT_3", a region "whole_genome"), which makes filenames like
# CpG_methylation_{condition}_{region}.txt ambiguous to reverse-parse from
# a plain "[^/]+" wildcard -- Snakemake's greedy regex can split them in
# the wrong place (and can even collide with unrelated literal filenames,
# e.g. CpG_methylation_all_conditions_all_regions.txt). Constraining both
# wildcards to the exact known values removes the ambiguity.
wildcard_constraints:
    condition="|".join(re.escape(c) for c in CONDITIONS),
    region="|".join(re.escape(r) for r in REGIONS + TE_REGIONS),


